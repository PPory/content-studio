# 复制成 .env 后填写。所有变量只在 Node 侧读取，不会进前端 bundle。
#
# **只有 VAULT_ROOT 需要在这里手填**——工作台起得来之后，剩下的都能在界面里改：
# 侧栏最底下「流水线已连接」那一行右边的齿轮。那儿还会告诉你每条链路现在通不通
#（vault 目录、Worker、DeepL 是免费版还是 Pro、claude / codex 装没装）。
# 字段清单的真源是 server/lib/settings-schema.mjs，加变量改那儿，这个文件只是给
# 「还没跑起来」的那一刻看的。

# Obsidian vault 绝对路径
VAULT_ROOT=D:/path/to/your/obsidian-vault

# Worker 地址（worker/ 部署出来的那个，不带结尾斜杠）
WORKER_URL=https://<your-worker>.workers.dev

# 工作台访问 Worker 的密钥。与 Telegram 的 secret 分开，可单独轮换。
# 同一串要同时：填在这里 + 在 worker/ 目录里执行 npx wrangler secret put WORKBENCH_KEY
WORKBENCH_KEY=

# 自动快照保留天数（默认 30）。工作台每次改动 posts.csv / metrics.csv /
# config/attention.json 之前都会先留一份，存在 data/.snapshots/。
# 无论怎么设，**最近 5 份永远保留**——只按天数清的话，长期不用之后回来改一次数据，
# 那一刻恰好一份都不剩。
SNAPSHOT_KEEP_DAYS=30


# ---- 可选能力：都不配也能用，配了各多一件事 ----------------------------------

# 划词翻译。免费版的 key 以 :fx 结尾，域名工作台自己会挑（拿 Pro 地址打免费 key
# 会 403，而报错里看不出是这个原因）。
DEEPL_API_KEY=

# 热点原文的兜底：先直取正文，抓不到才走它。公众号 / 知乎这类要真浏览器的页面
# 配了就能读。二选一即可——云端填 key，自托管填地址（自托管默认不设鉴权）。
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=

# 另外部署了一份排版工具时填它的地址（内嵌的那一页不受影响）
TYPESET_URL=

# 「热点 → 平台热榜」那六个榜的数据源：自己部署的 60s API 实例根地址，不带结尾斜杠
#（github.com/vikiboss/60s，接入约定见 docs/60s-api.md）。
# 留空的话那一栏永远只显示上一次成功的快照——**不看时间戳看不出来**，所以设置面板里
# 给它挂了一枚自检点。另外两个 tab（AI 情报 / 模型榜）不受它影响。
SIXTY_SECONDS_API_BASE_URL=

# ---- 本机路径：留空就用默认值 -------------------------------------------------

# 数据页「自动发现」扫的第一个目录（另一个恒定是 data/inbox/）。留空 = 系统下载目录
DOWNLOADS_DIR=
# wechat-typeset 装在哪。留空 = content-studio 的同级目录（也就是 ../../wechat-typeset）
TYPESET_DIR=
# MediaCrawler 装在哪（只被 scripts/social-probe.mjs 用到）。留空 = ../../MediaCrawler
MEDIACRAWLER_DIR=
# worker/ 装在哪。**只用来找提示词文件**（设置面板「提示词 · 流水线」那一段直接读写
# 它底下的 prompt/*.md）——取数据仍然走上面那个 WORKER_URL，和本地目录无关。
# 留空 = workbench 的同级 worker/（合仓之后就在那儿，基本不用填）
WORKER_DIR=
# Pi Agent SDK 专家执行（素材查缺 / 品控九问 / 事实核查）
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=
AGENT_LLM_PROTOCOL=openai-completions
BRAVE_SEARCH_API_KEY=
