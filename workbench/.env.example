# 复制为 .env 后填写。所有变量只在本机 Node 服务读取，不进入前端、备份、导出或 Git。
# 字段清单真源：server/lib/settings-schema.mjs。

# SQLite、资源、备份和导出的唯一总根。
# 留空时使用系统“文档”目录下的 Xenho。
XENHO_HOME=

# 本机 Pi Agent 模型。密钥留在 .env。
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
# 知识库提炼。模型留空时默认使用 gemini-3.7-flash-high；地址和密钥仍可独立配置。
# 挑模型看逐字校验丢弃率（scripts/wiki-ingest.mjs 每轮会报），不要凭产出好看与否判断。
# 助手那条通道的配额会断，而提炼是长跑——所以地址和密钥也能单独换，
# 例如指向本机跑着的 OpenAI 兼容代理继续跑。
AGENT_INGEST_MODEL=gemini-3.7-flash-high
AGENT_INGEST_BASE_URL=
AGENT_INGEST_API_KEY=
AGENT_LLM_API_KEY=
AGENT_LLM_PROTOCOL=openai-completions

# 可选：划词翻译、网页正文兜底、平台热榜和网页搜索。
DEEPL_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=
SIXTY_SECONDS_API_BASE_URL=
BRAVE_SEARCH_API_KEY=
# 网页检索供应商。填了 Tavily 就优先用它：它按问题意图排序、每条结果带正文摘录，
# 找官方文档比 Brave 的通用索引准。留空 AGENT_SEARCH_PROVIDER 则自动选。
TAVILY_API_KEY=
AGENT_SEARCH_PROVIDER=

# 可选：本机工具。
TYPESET_DIR=
TYPESET_URL=
MEDIACRAWLER_DIR=
