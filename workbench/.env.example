# 复制为 .env 后填写。所有变量只在本机 Node 服务读取，不进入前端、备份、导出或 Git。
# 字段清单真源：server/lib/settings-schema.mjs。

# SQLite、资源、备份和导出的唯一总根。
# 留空时使用系统“文档”目录下的 Xenho。
XENHO_HOME=

# 本机 Pi Agent 模型。密钥留在 .env。
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
# 知识库提炼模型。留空跟随上面那个。挑模型看逐字校验丢弃率，见 scripts/wiki-ingest.mjs
AGENT_INGEST_MODEL=
AGENT_LLM_API_KEY=
AGENT_LLM_PROTOCOL=openai-completions

# 可选：划词翻译、网页正文兜底、平台热榜和网页搜索。
DEEPL_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=
SIXTY_SECONDS_API_BASE_URL=
BRAVE_SEARCH_API_KEY=

# 可选：本机工具。
TYPESET_DIR=
TYPESET_URL=
MEDIACRAWLER_DIR=
