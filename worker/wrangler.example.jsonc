// 复制成 `wrangler.jsonc` 再填自己的值：
//
//   cp wrangler.example.jsonc wrangler.jsonc
//
// `wrangler.jsonc` 在 .gitignore 里，填进去的东西不会进版本库。
// **不要直接改这个文件**——它是给下一个 clone 的人看的。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "content-pipeline",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // prompt/*.md 作为文本模块打包进 Worker（提示词外置，编辑 .md 后 deploy 即生效）
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  // 单条 cron，不是三条：免费账户单账户上限 5 个。每天 14:00 的整理不靠独立 cron，
  // 而在 scheduled 里判断 event.scheduledTime 是否 UTC 06:00 来触发（见 src/index.js）。
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // ── 自定义域名：**只用 Telegram 的话可以整段删掉** ────────────────────────
  // 但**接飞书就必须配**：飞书的事件推送到不了 `*.workers.dev`（该域名在国内解析
  // 被污染，而 Cloudflare 免费版在大陆没有节点），后台填回调地址时会一直报
  // 「请求3秒超时」。换成自己的域名走另一条解析路径才通。
  // 域名要先托管在同一个 Cloudflare 账号下，DNS 记录由 wrangler 自动创建。
  "routes": [
    { "pattern": "pipeline.example.com", "custom_domain": true }
  ],
  // **配了 routes 就必须显式写这行**：否则 wrangler 会默认把 workers.dev 地址关掉，
  // 而 Telegram webhook 和工作台用的都是那个地址——加个自定义域名会顺手把它们
  // 一起弄挂，部署时还不报错，只在警告里提一句。
  "workers_dev": true,

  // 长任务异步执行器：含 LLM 生成的命令超过 webhook waitUntil 的 30 秒存活期，
  // 一律入队到这个 Workflow 跑（见 src/jobs.js）。
  "workflows": [
    { "name": "content-jobs", "binding": "JOBS", "class_name": "JobWorkflow" }
  ],

  // 数据库。先 `npx wrangler d1 create content-pipeline`，把返回的 id 填进来，
  // 再 `npx wrangler d1 execute content-pipeline --remote --file=schema.sql` 建表。
  "d1_databases": [
    { "binding": "DB", "database_name": "content-pipeline", "database_id": "<d1 create 返回的 database_id>", "migrations_dir": "migrations" }
  ],

  "observability": { "enabled": true },

  "vars": {
    // 任何 OpenAI 兼容的服务都行（DeepSeek、智谱、月之暗面、自建代理…）。
    // 提示词是照 thinking 类模型调的，换成别的模型产出质量会有差异。
    "LLM_BASE_URL": "https://api.deepseek.com/v1",
    "LLM_MODEL": "deepseek-chat",

    // ── Telegram（不用就留空）─────────────────────────────────────────
    // 你的 chat_id：给 bot 发条消息，`npx wrangler tail` 里能看到。
    // 留空＝不限制发信人，**公网可达的 bot 一定要填**。
    "ALLOWED_CHAT_ID": "",
    "OWNER_CHAT_ID": "",

    // ── Obsidian vault 归档（不用就留空）──────────────────────────────
    // 长文和素材会以 Markdown 写进这个 GitHub 仓库（建议私有——稿件是未发布内容）。
    // 配套的 GITHUB_TOKEN 是 secret。两者任一为空就整个跳过归档，流水线照常跑。
    "VAULT_REPO": "",

    // ── 飞书（不用就留空）────────────────────────────────────────────
    // 开放平台 → 自建应用 → 凭证与基础信息里的 App ID。
    "LARK_APP_ID": "",
    // 机主的 open_id。留空时 bot 对任何人都响应命令——首次部署要先发条消息、
    // 从 `wrangler tail` 里读出来才有值可填，所以这步别拖。
    "LARK_OWNER_OPEN_ID": ""
  }
}
